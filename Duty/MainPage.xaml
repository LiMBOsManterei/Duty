<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Duty.MainPage"
               BackgroundColor="#F7F8FA"
             Shell.NavBarIsVisible="False">
    
    <!-- Корневой Grid нужен для позиционирования плавающей кнопки поверх скролла -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,100" Spacing="24">

                <!-- ШАПКА: Итого + Обновить -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Text="Итого" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="#1A1A1A" 
                           VerticalOptions="Center"/>

                    <Button Grid.Column="1" 
                            Text="&#xf021;" 
                            FontFamily="FontAwesome" 
                            FontSize="20" 
                            TextColor="#1A1A1A" 
                            BackgroundColor="Transparent" 
                            WidthRequest="44" 
                            HeightRequest="44"
                            CornerRadius="22"
                            Padding="0"/>
                </Grid>

                <!-- ОБЩИЙ БАЛАНС -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Общий баланс" FontSize="14" TextColor="#8E8E93"/>
                        <Label Text="150 000 ₽" FontSize="32" FontAttributes="Bold" TextColor="#1A1A1A"/>
                    </VerticalStackLayout>

                    <!-- Кнопка редактирования (Карандаш) -->
                    <Border Grid.Column="1" 
                            BackgroundColor="#EFEFF4" 
                            StrokeThickness="0"
                            WidthRequest="44" 
                            HeightRequest="44" 
                            StrokeShape="RoundRectangle 22"
                            VerticalOptions="End">
                        <Label Text="&#xf304;" 
                               FontFamily="FontAwesome" 
                               FontSize="18" 
                               TextColor="#1A1A1A" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- НЕДАВНИЕ ТРАТЫ -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="Недавние траты" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" Margin="0,10,0,0"/>

                    <!-- Сетка по 3 элемента в ряд -->
                    <CollectionView ItemsSource="{Binding Expenses}" 
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <!-- Span="3" делает ровно 3 колонки -->
                            <GridItemsLayout Orientation="Vertical" 
                                             Span="3" 
                                             HorizontalItemSpacing="12" 
                                             VerticalItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F0F1F5" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 18" 
                                        Padding="16">
                                    <VerticalStackLayout Spacing="12">

                                        <!-- Белый круг с иконкой -->
                                        <Border BackgroundColor="White" 
                                                StrokeThickness="0" 
                                                StrokeShape="RoundRectangle 16" 
                                                WidthRequest="32" 
                                                HeightRequest="32" 
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding Icon}" 
                                                   FontFamily="FontAwesome" 
                                                   FontSize="14" 
                                                   TextColor="{Binding IconColor}" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Label Text="{Binding Name}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="#1A1A1A" 
                                               LineBreakMode="TailTruncation"/>

                                        <Label Text="{Binding Amount}" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#1A1A1A"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ПЛАВАЮЩАЯ КНОПКА (FAB) -->
        <Button Text="&#xf067;" 
                FontFamily="FontAwesome" 
                FontSize="24" 
                TextColor="White" 
                BackgroundColor="#1C1C1E"
                WidthRequest="64" 
                HeightRequest="64"
                CornerRadius="32"
                Padding="0"
                HorizontalOptions="End" 
                VerticalOptions="End" 
                Margin="0,0,20,30">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.3"/>
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>
