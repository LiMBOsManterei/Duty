<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Duty.ViewModels"
             x:Class="Duty.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Duty"
             BackgroundColor="#F7F8FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="Ink">#1A1A1A</Color>
        <Color x:Key="Muted">#8E8E93</Color>
        <Color x:Key="CardSurface">#F0F1F5</Color>
        <Color x:Key="FieldSurface">#F2F2F7</Color>
        <Color x:Key="Accent">#1C1C1E</Color>
        <Color x:Key="Danger">#FF3B30</Color>
        <Color x:Key="Hairline">#E5E5EA</Color>

        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="SheetTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource FieldSurface}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="InputEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="MinimumHeightRequest" Value="50" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="DangerTextButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Danger}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FontAwesome" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FontAwesome" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

   

    <Grid>

        <!-- Основной скролл страницы: хедер + сетка трат -->
        <CollectionView ItemsSource="{Binding Expenses}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        ItemSizingStrategy="MeasureAllItems"
                        MaximumWidthRequest="820"
                        HorizontalOptions="Center"
                        Margin="20,0">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="0,40,0,16" Spacing="24">

                    <!-- ШАПКА: Итого + Обновить + спинер + отпровить -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Итого"
                               
                               FontSize="32"    
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center" />

                        
                        
                        <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto">
                            
                                <Button Grid.Column="0"
                                Text="&#xf021;"
                                Style="{StaticResource RefreshButton}"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                SemanticProperties.Description="Обновить данные" />
                            <Button Grid.Column="1"
                                Text="&#xe09a;"
                                Style="{StaticResource RefreshButton}"
                                Command="{Binding SendDbToFirebaseCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                SemanticProperties.Description="отправить данные" />

                            <ActivityIndicator Grid.Column="2"
                                 IsRunning="{Binding IsSyncing}"
                                 IsVisible="{Binding IsSyncing}"
                                 Color="#1A1A1A"
                                 WidthRequest="24"
                                 HeightRequest="24"
                                 VerticalOptions="Center"
                                 Margin="0,0,8,0" />
                            

                        </Grid>
                        
                        
                    </Grid>

                    <!-- ОБЩИЙ БАЛАНС -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Общий баланс" FontSize="14" TextColor="#8E8E93" />
                            <Label Text="{Binding FormattedBalance}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A" />
                        </VerticalStackLayout>

                        <!-- Кнопка редактирования баланса -->
                        <Border Grid.Column="1"
                                BackgroundColor="#EFEFF4"
                                StrokeThickness="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="End"
                                SemanticProperties.Description="Изменить общий баланс">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditBalanceCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#xf304;"
                                   FontFamily="FontAwesome"
                                   FontSize="18"
                                   TextColor="#1A1A1A"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- НЕДАВНИЕ ТРАТЫ -->
                    

                        <Grid ColumnDefinitions="*, auto">
                            <Label Text="Недавние траты"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#1A1A1A"
                                Margin="0,10,0,0" 
                                Grid.Column="0"  />

                        <Button Grid.Column="1"
                                Text="&#xf82a;"
                                FontFamily="FontAwesome"
                                FontSize="22"
                                TextColor="#1A1A1A"
                                BackgroundColor="Transparent"
                                Padding="0"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                WidthRequest="28"
                                HeightRequest="28"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Command="{Binding AllDeleteCommand}"
                                 />


                    </Grid>
                    
                    

                    <!-- Пустое состояние. EmptyView у CollectionView на Windows
                         приводит к падению WinUI, поэтому показываем его в хедере. -->
                    <VerticalStackLayout IsVisible="{Binding HasNoExpenses}"
                                         Padding="0,10,0,20"
                                         Spacing="12"
                                         HorizontalOptions="Center">
                        <Border BackgroundColor="#EFEFF4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 32"
                                WidthRequest="64"
                                HeightRequest="64"
                                HorizontalOptions="Center">
                            <Label Text="&#xf0d6;"
                                   FontFamily="FontAwesome"
                                   FontSize="24"
                                   TextColor="#8E8E93"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Пока нет трат"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Нажмите +, чтобы добавить первую запись"
                               FontSize="13"
                               TextColor="#8E8E93"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpenseItemViewModel">

                    
                        <Border BackgroundColor="#F0F1F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16"
                            MinimumHeightRequest="118"
                            SemanticProperties.Description="{Binding AccessibilityDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditCommand}" />
                        </Border.GestureRecognizers>
                        
                        <VerticalStackLayout Spacing="12">
                            <!-- Белый круг с иконкой -->

                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            WidthRequest="32"
                            HeightRequest="32"
                            HorizontalOptions="Start">
                                    <Label Text="{Binding Icon}"
                               FontFamily="FontAwesome"
                               FontSize="14"
                               TextColor="{Binding IconColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                                </Border>

                                <!-- Кнопка удаления траты -->
                                <Button Grid.Column="1"
                            Text="&#xf2ed;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="#FF3B30"
                            BackgroundColor="Transparent"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            WidthRequest="28"
                            HeightRequest="28"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding FastDeleteCommand}"
                             />
                            </Grid>


                            <!--<Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    HorizontalOptions="Start">
                                <Label Text="{Binding Icon}"
                                       FontFamily="FontAwesome"
                                       FontSize="14"
                                       TextColor="{Binding IconColor}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>-->

                            <Label Text="{Binding Name}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Label Text="{Binding FormattedAmount}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="96" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ПЛАВАЮЩАЯ КНОПКА (FAB) -->
        <Button Text="&#xf067;"
                FontFamily="FontAwesome"
                FontSize="24"
                TextColor="White"
                BackgroundColor="#1C1C1E"
                WidthRequest="64"
                HeightRequest="64"
                CornerRadius="32"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,30"
                Command="{Binding AddExpenseCommand}"
                SemanticProperties.Description="Добавить трату">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.3" />
            </Button.Shadow>
        </Button>

        <!-- ФОРМА ТРАТЫ -->
        <Grid IsVisible="{Binding ExpenseEditor.IsOpen}" ZIndex="20">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExpenseEditor.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="620"
                    Margin="0,80,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-6" Radius="24" Opacity="0.18" />
                </Border.Shadow>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="20,22,20,28" Spacing="18">

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding ExpenseEditor.Title}"
                                   Style="{StaticResource SheetTitle}" />
                            <Button Grid.Column="1"
                                    Text="&#xf00d;"
                                    Style="{StaticResource CloseButton}"
                                    Command="{Binding ExpenseEditor.CloseCommand}"
                                    IsEnabled="{Binding ExpenseEditor.IsNotSaving}"
                                    SemanticProperties.Description="Закрыть форму" />
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Название" Style="{StaticResource FormLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding ExpenseEditor.Name}"
                                       Placeholder="Например, Продукты"
                                       MaxLength="40"
                                       Style="{StaticResource InputEntry}"
                                       IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Сумма" Style="{StaticResource FormLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding ExpenseEditor.AmountText}"
                                           Placeholder="0"
                                           Keyboard="Numeric"
                                           MaxLength="20"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding ExpenseEditor.SaveCommand}"
                                           Style="{StaticResource InputEntry}"
                                           IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                                    <Label Grid.Column="1"
                                           Text="₽"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#8E8E93"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Категория" Style="{StaticResource FormLabel}" />
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="Start"
                                        BindableLayout.ItemsSource="{Binding ExpenseEditor.Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                        <Border BackgroundColor="{Binding BackgroundColor}"
                                                Stroke="{Binding BorderBrush}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="12,8"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                
                                                <Label Text="{Binding Icon}"
                                                       FontFamily="FontAwesome"
                                                       FontSize="12"
                                                       TextColor="{Binding ForegroundColor}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding ForegroundColor}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ExpenseEditor.ErrorMessage}"
                               IsVisible="{Binding ExpenseEditor.HasError}"
                               FontSize="13"
                               TextColor="#FF3B30"
                               LineBreakMode="WordWrap" />

                        <Button Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExpenseEditor.SaveCommand}"
                                IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />

                        <Button Text="Удалить трату"
                                Style="{StaticResource DangerTextButton}"
                                Command="{Binding ExpenseEditor.DeleteCommand}"
                                IsVisible="{Binding ExpenseEditor.IsEditing}"
                                IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ФОРМА БАЛАНСА -->
        <Grid IsVisible="{Binding BalanceEditor.IsOpen}" ZIndex="21">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BalanceEditor.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Margin="24">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Изменить баланс" Style="{StaticResource SheetTitle}" />
                        <Button Grid.Column="1"
                                Text="&#xf00d;"
                                Style="{StaticResource CloseButton}"
                                Command="{Binding BalanceEditor.CloseCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}"
                                SemanticProperties.Description="Закрыть форму баланса" />
                    </Grid>

                    <Label Text="Сумма, доступная к тратам"
                           Style="{StaticResource Hint}" />

                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Entry Text="{Binding BalanceEditor.AmountText}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   MaxLength="20"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding BalanceEditor.SaveCommand}"
                                   Style="{StaticResource InputEntry}"
                                   IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                            <Label Grid.Column="1"
                                   Text="₽"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#8E8E93"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding BalanceEditor.ErrorMessage}"
                           IsVisible="{Binding BalanceEditor.HasError}"
                           FontSize="13"
                           TextColor="#FF3B30"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Text="Отмена"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BalanceEditor.CloseCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                        <Button Grid.Column="1"
                                Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BalanceEditor.SaveCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ЗАГРУЗКА -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#E6F7F8FA"
              ZIndex="30">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="#1C1C1E"
                                   WidthRequest="36"
                                   HeightRequest="36" />
                <Label Text="Загрузка..."
                       FontSize="13"
                       TextColor="#8E8E93"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
        <Border IsVisible="{Binding IsSyncStatusVisible}"
        BackgroundColor="{Binding SyncStatusColor}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        Padding="16,10"
        HorizontalOptions="Center"
        VerticalOptions="End"
        Margin="0,0,0,32">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="&#xf00c;"
               FontFamily="FontAwesome"
               TextColor="White"
               FontSize="14"
               VerticalOptions="Center" />
                <Label Text="{Binding SyncStatusText}"
               TextColor="White"
               FontSize="14"
               FontAttributes="Bold"
               VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
