<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Duty.ViewModels"
             x:Class="Duty.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Duty"
             BackgroundColor="#F7F8FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="Ink">#1A1A1A</Color>
        <Color x:Key="Muted">#8E8E93</Color>
        <Color x:Key="CardSurface">#F0F1F5</Color>
        <Color x:Key="FieldSurface">#F2F2F7</Color>
        <Color x:Key="Accent">#1C1C1E</Color>
        <Color x:Key="Danger">#FF3B30</Color>
        <Color x:Key="Warning">#FF9500</Color>
        <Color x:Key="Hairline">#E5E5EA</Color>

        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="SheetTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource FieldSurface}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="InputEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="MinimumHeightRequest" Value="50" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="DangerTextButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Danger}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FontAwesome" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FontAwesome" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FontAwesome" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
        </Style>

        <Style x:Key="SheetBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="MaximumWidthRequest" Value="520" />
            <Setter Property="Margin" Value="20" />
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- Основной список: хедер + сетка трат -->
        <CollectionView ItemsSource="{Binding Expenses}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        ItemSizingStrategy="MeasureAllItems"
                        MaximumWidthRequest="820"
                        HorizontalOptions="Center"
                        Margin="20,0">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="0,40,0,16" Spacing="20">

                    <!-- ШАПКА: Итого + подключение + обновить + отправить -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Итого"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Button Text="&#xf1c0;"
                                    Style="{StaticResource RefreshButton}"
                                    Command="{Binding Connections.OpenCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SemanticProperties.Description="Подключения к базе" />

                            <Button Text="&#xf021;"
                                    Style="{StaticResource RefreshButton}"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SemanticProperties.Description="Обновить данные" />

                            <Button Text="&#xe09a;"
                                    Style="{StaticResource RefreshButton}"
                                    Command="{Binding SendDbToFirebaseCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SemanticProperties.Description="Отправить данные в облако" />

                            <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                               IsVisible="{Binding IsSyncing}"
                                               Color="#1A1A1A"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               VerticalOptions="Center"
                                               Margin="4,0,0,0" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- ОБЩИЙ БАЛАНС -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Общий баланс" FontSize="14" TextColor="#8E8E93" />
                            <Label Text="{Binding FormattedBalance}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A" />
                            <Label Text="{Binding ActiveConnectionText}"
                                   FontSize="12"
                                   TextColor="#8E8E93" />
                            <Label Text="{Binding LocalModeText}"
                                   IsVisible="{Binding ShowLocalModeHint}"
                                   FontSize="12"
                                   TextColor="#FF9500" />
                        </VerticalStackLayout>

                        <!-- Кнопка редактирования баланса -->
                        <Border Grid.Column="1"
                                BackgroundColor="#EFEFF4"
                                StrokeThickness="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="End"
                                SemanticProperties.Description="Изменить общий баланс">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditBalanceCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#xf304;"
                                   FontFamily="FontAwesome"
                                   FontSize="18"
                                   TextColor="#1A1A1A"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- НЕДАВНИЕ ТРАТЫ + удалить все -->
                    <Grid ColumnDefinitions="*, auto">
                        <Label Text="Недавние траты"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               Margin="0,10,0,0"
                               Grid.Column="0" />

                        <Button Grid.Column="1"
                                Text="&#xf82a;"
                                FontFamily="FontAwesome"
                                FontSize="22"
                                TextColor="#1A1A1A"
                                BackgroundColor="Transparent"
                                Padding="0"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                WidthRequest="28"
                                HeightRequest="28"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Command="{Binding AllDeleteCommand}"
                                SemanticProperties.Description="Удалить все записи" />
                    </Grid>

                    <!-- Пустое состояние. EmptyView у CollectionView на Windows
                         приводит к падению WinUI, поэтому показываем его в хедере. -->
                    <VerticalStackLayout IsVisible="{Binding HasNoExpenses}"
                                         Padding="0,10,0,20"
                                         Spacing="12"
                                         HorizontalOptions="Center">
                        <Border BackgroundColor="#EFEFF4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 32"
                                WidthRequest="64"
                                HeightRequest="64"
                                HorizontalOptions="Center">
                            <Label Text="&#xf0d6;"
                                   FontFamily="FontAwesome"
                                   FontSize="24"
                                   TextColor="#8E8E93"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Пока нет трат"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Нажмите +, чтобы добавить первую запись"
                               FontSize="13"
                               TextColor="#8E8E93"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpenseItemViewModel">
                    <Border BackgroundColor="#F0F1F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16"
                            MinimumHeightRequest="118"
                            SemanticProperties.Description="{Binding AccessibilityDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Border Grid.Column="0"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Icon}"
                                           FontFamily="FontAwesome"
                                           FontSize="14"
                                           TextColor="{Binding IconColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Кнопка удаления траты -->
                                <Button Grid.Column="1"
                                        Text="&#xf2ed;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        TextColor="#FF3B30"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        MinimumWidthRequest="0"
                                        MinimumHeightRequest="0"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Command="{Binding FastDeleteCommand}"
                                        SemanticProperties.Description="Удалить трату" />
                            </Grid>

                            <Label Text="{Binding Name}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Label Text="{Binding FormattedAmount}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="96" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ПЛАВАЮЩАЯ КНОПКА (FAB) -->
        <Button Text="&#xf067;"
                FontFamily="FontAwesome"
                FontSize="24"
                TextColor="White"
                BackgroundColor="#1C1C1E"
                WidthRequest="64"
                HeightRequest="64"
                CornerRadius="32"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,30"
                Command="{Binding AddExpenseCommand}"
                SemanticProperties.Description="Добавить трату">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.3" />
            </Button.Shadow>
        </Button>

        <!-- ФОРМА ТРАТЫ -->
        <Grid IsVisible="{Binding ExpenseEditor.IsOpen}" ZIndex="20">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExpenseEditor.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="620"
                    Margin="0,80,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-6" Radius="24" Opacity="0.18" />
                </Border.Shadow>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="20,22,20,28" Spacing="18">

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding ExpenseEditor.Title}"
                                   Style="{StaticResource SheetTitle}" />
                            <Button Grid.Column="1"
                                    Text="&#xf00d;"
                                    Style="{StaticResource CloseButton}"
                                    Command="{Binding ExpenseEditor.CloseCommand}"
                                    IsEnabled="{Binding ExpenseEditor.IsNotSaving}"
                                    SemanticProperties.Description="Закрыть форму" />
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Название" Style="{StaticResource FormLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding ExpenseEditor.Name}"
                                       Placeholder="Например, Продукты"
                                       MaxLength="40"
                                       Style="{StaticResource InputEntry}"
                                       IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Сумма" Style="{StaticResource FormLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding ExpenseEditor.AmountText}"
                                           Placeholder="0"
                                           Keyboard="Numeric"
                                           MaxLength="20"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding ExpenseEditor.SaveCommand}"
                                           Style="{StaticResource InputEntry}"
                                           IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                                    <Label Grid.Column="1"
                                           Text="₽"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#8E8E93"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Категория"
                                       Style="{StaticResource FormLabel}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="&#xf013;"
                                        Style="{StaticResource IconButton}"
                                        FontSize="15"
                                        TextColor="#8E8E93"
                                        Command="{Binding Categories.OpenCommand}"
                                        SemanticProperties.Description="Управление категориями" />
                            </Grid>

                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="Start"
                                        BindableLayout.ItemsSource="{Binding ExpenseEditor.Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                        <Border BackgroundColor="{Binding BackgroundColor}"
                                                Stroke="{Binding BorderBrush}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="12,8"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Icon}"
                                                       FontFamily="FontAwesome"
                                                       FontSize="12"
                                                       TextColor="{Binding ForegroundColor}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding ForegroundColor}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ExpenseEditor.ErrorMessage}"
                               IsVisible="{Binding ExpenseEditor.HasError}"
                               FontSize="13"
                               TextColor="#FF3B30"
                               LineBreakMode="WordWrap" />

                        <Button Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExpenseEditor.SaveCommand}"
                                IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />

                        <Button Text="Удалить трату"
                                Style="{StaticResource DangerTextButton}"
                                Command="{Binding ExpenseEditor.DeleteCommand}"
                                IsVisible="{Binding ExpenseEditor.IsEditing}"
                                IsEnabled="{Binding ExpenseEditor.IsNotSaving}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ФОРМА БАЛАНСА -->
        <Grid IsVisible="{Binding BalanceEditor.IsOpen}" ZIndex="21">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BalanceEditor.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Margin="24">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Изменить баланс" Style="{StaticResource SheetTitle}" />
                        <Button Grid.Column="1"
                                Text="&#xf00d;"
                                Style="{StaticResource CloseButton}"
                                Command="{Binding BalanceEditor.CloseCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}"
                                SemanticProperties.Description="Закрыть форму баланса" />
                    </Grid>

                    <Label Text="Сумма, доступная к тратам"
                           Style="{StaticResource Hint}" />

                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Entry Text="{Binding BalanceEditor.AmountText}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   MaxLength="20"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding BalanceEditor.SaveCommand}"
                                   Style="{StaticResource InputEntry}"
                                   IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                            <Label Grid.Column="1"
                                   Text="₽"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#8E8E93"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding BalanceEditor.ErrorMessage}"
                           IsVisible="{Binding BalanceEditor.HasError}"
                           FontSize="13"
                           TextColor="#FF3B30"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Text="Отмена"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BalanceEditor.CloseCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                        <Button Grid.Column="1"
                                Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BalanceEditor.SaveCommand}"
                                IsEnabled="{Binding BalanceEditor.IsNotSaving}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- СПИСОК ПОДКЛЮЧЕНИЙ -->
        <Grid IsVisible="{Binding Connections.IsOpen}" ZIndex="22">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Connections.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Style="{StaticResource SheetBorder}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Label Text="Подключения" Style="{StaticResource SheetTitle}" />

                        <Button Grid.Column="1"
                                Text="&#xf067;"
                                Style="{StaticResource IconButton}"
                                TextColor="#1A1A1A"
                                Command="{Binding Connections.AddCommand}"
                                SemanticProperties.Description="Добавить подключение" />

                        <Button Grid.Column="2"
                                Text="&#xf00d;"
                                Style="{StaticResource CloseButton}"
                                Command="{Binding Connections.CloseCommand}"
                                SemanticProperties.Description="Закрыть список подключений" />
                    </Grid>

                    <Label Text="Нажмите на название, чтобы переключиться на эту базу."
                           Style="{StaticResource Hint}" />

                    <ScrollView MaximumHeightRequest="360" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding Connections.Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionListItemViewModel">
                                    <Border BackgroundColor="#F0F1F5"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="14,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ActivateCommand}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#1A1A1A"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="&#xf00c;"
                                                   FontFamily="FontAwesome"
                                                   FontSize="14"
                                                   TextColor="#34C759"
                                                   IsVisible="{Binding IsActive}"
                                                   VerticalOptions="Center" />

                                            <Button Grid.Column="2"
                                                    Text="&#xf304;"
                                                    Style="{StaticResource IconButton}"
                                                    FontSize="15"
                                                    TextColor="#8E8E93"
                                                    Command="{Binding EditCommand}"
                                                    SemanticProperties.Description="Изменить подключение" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ФОРМА ПОДКЛЮЧЕНИЯ -->
        <Grid IsVisible="{Binding Connections.IsEditorOpen}" ZIndex="23">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Connections.CloseEditorCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Style="{StaticResource SheetBorder}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding Connections.EditorTitle}"
                               Style="{StaticResource SheetTitle}" />
                        <Button Grid.Column="1"
                                Text="&#xf00d;"
                                Style="{StaticResource CloseButton}"
                                Command="{Binding Connections.CloseEditorCommand}"
                                SemanticProperties.Description="Закрыть форму подключения" />
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Название" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding Connections.EditorName}"
                                   Placeholder="Например, Основная база"
                                   MaxLength="60"
                                   Style="{StaticResource InputEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Адрес базы (Realtime Database URL)" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding Connections.EditorUrl}"
                                   Placeholder="https://project-default-rtdb.firebaseio.com/"
                                   Keyboard="Url"
                                   MaxLength="200"
                                   Style="{StaticResource InputEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding Connections.EditorError}"
                           IsVisible="{Binding Connections.HasEditorError}"
                           FontSize="13"
                           TextColor="#FF3B30"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Text="Отмена"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding Connections.CloseEditorCommand}" />
                        <Button Grid.Column="1"
                                Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding Connections.SaveCommand}"
                                IsEnabled="{Binding Connections.IsNotBusy}" />
                    </Grid>

                    <Button Text="Удалить подключение"
                            Style="{StaticResource DangerTextButton}"
                            Command="{Binding Connections.DeleteCommand}"
                            IsVisible="{Binding Connections.IsEditing}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- СПИСОК КАТЕГОРИЙ -->
        <Grid IsVisible="{Binding Categories.IsOpen}" ZIndex="24">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Categories.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Style="{StaticResource SheetBorder}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Label Text="Категории" Style="{StaticResource SheetTitle}" />

                        <Button Grid.Column="1"
                                Text="&#xf067;"
                                Style="{StaticResource IconButton}"
                                TextColor="#1A1A1A"
                                Command="{Binding Categories.AddCategoryCommand}"
                                SemanticProperties.Description="Добавить категорию" />

                        <Button Grid.Column="2"
                                Text="&#xf00d;"
                                Style="{StaticResource CloseButton}"
                                Command="{Binding Categories.CloseCommand}"
                                SemanticProperties.Description="Закрыть список категорий" />
                    </Grid>

                    <ScrollView MaximumHeightRequest="380" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding Categories.Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryItemViewModel">
                                    <Border BackgroundColor="#F0F1F5"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="White"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Icon}"
                                                       FontFamily="FontAwesome"
                                                       FontSize="14"
                                                       TextColor="{Binding IconColor}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#1A1A1A"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />

                                            <Button Grid.Column="2"
                                                    Text="&#xf304;"
                                                    Style="{StaticResource IconButton}"
                                                    FontSize="15"
                                                    TextColor="#8E8E93"
                                                    Command="{Binding EditCommand}"
                                                    SemanticProperties.Description="Изменить категорию" />

                                            <Button Grid.Column="3"
                                                    Text="&#xf2ed;"
                                                    Style="{StaticResource IconButton}"
                                                    FontSize="15"
                                                    TextColor="#FF3B30"
                                                    Command="{Binding DeleteCommand}"
                                                    SemanticProperties.Description="Удалить категорию" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ФОРМА КАТЕГОРИИ -->
        <Grid IsVisible="{Binding Categories.IsEditorOpen}" ZIndex="25">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Categories.CloseEditorCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Style="{StaticResource SheetBorder}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="28" Opacity="0.2" />
                </Border.Shadow>

                <ScrollView MaximumHeightRequest="560" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding Categories.EditorTitle}"
                                   Style="{StaticResource SheetTitle}" />
                            <Button Grid.Column="1"
                                    Text="&#xf00d;"
                                    Style="{StaticResource CloseButton}"
                                    Command="{Binding Categories.CloseEditorCommand}"
                                    SemanticProperties.Description="Закрыть форму категории" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{Binding Categories.PreviewColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Categories.SelectedIcon}"
                                       FontFamily="FontAwesome"
                                       FontSize="22"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="Название" Style="{StaticResource FormLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Entry Text="{Binding Categories.EditorName}"
                                           Placeholder="Например, Кафе"
                                           MaxLength="40"
                                           Style="{StaticResource InputEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Цвет" Style="{StaticResource FormLabel}" />
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding Categories.PaletteColors}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColorOptionViewModel">
                                        <Border BackgroundColor="{Binding Swatch}"
                                                Stroke="{Binding BorderBrush}"
                                                StrokeThickness="{Binding BorderWidth}"
                                                StrokeShape="RoundRectangle 17"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Иконка" Style="{StaticResource FormLabel}" />
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding Categories.PaletteIcons}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IconOptionViewModel">
                                        <Border BackgroundColor="{Binding BackgroundColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="42"
                                                HeightRequest="42"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Icon}"
                                                   FontFamily="FontAwesome"
                                                   FontSize="16"
                                                   TextColor="{Binding ForegroundColor}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding Categories.EditorError}"
                               IsVisible="{Binding Categories.HasEditorError}"
                               FontSize="13"
                               TextColor="#FF3B30"
                               LineBreakMode="WordWrap" />

                        <Button Text="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding Categories.SaveEditorCommand}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ЗАГРУЗКА -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#E6F7F8FA"
              ZIndex="30">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="#1C1C1E"
                                   WidthRequest="36"
                                   HeightRequest="36" />
                <Label Text="Загрузка..."
                       FontSize="13"
                       TextColor="#8E8E93"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- СТАТУСНАЯ ПЛАШКА -->
        <Border IsVisible="{Binding IsSyncStatusVisible}"
                BackgroundColor="{Binding SyncStatusColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="16,10"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,32"
                ZIndex="31">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding SyncStatusIcon}"
                       FontFamily="FontAwesome"
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Label Text="{Binding SyncStatusText}"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
